@inject HttpClient Http
@inject IJSRuntime JS
@using SistemaLicencias.SHARED.DTOs
@using MudBlazor
@inject GoogleMapsInterop MapsInterop
@inject IDialogService DialogService

<MudDialog >
    <DialogContent>
        
        <div class="map-container">

            <iframe src="https://www.google.com/maps/d/u/0/embed?mid=1K3bjGXqYzukUr6nYP1RZ5LsEK7Y&ehbc=2E312F&ll=-12.062118296145636,-76.93472867718684&z=13"
                    loading="lazy">
            </iframe>

        </div>

        <MudPaper Class="content-container" Elevation="1">
        <MudGrid Class="mb-2">

            <MudItem xs="12">
                <MudGrid Spacing="2">

                    <MudItem xs="6">
                        <MudSelect T="int"
                                   Label="Selecciona una zona"
                                   Value="_zonaSeleccionada"
                                   ValueChanged="OnZonaChanged"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Margin="Margin.Dense"
                                       Class="field-white">

                            <MudSelectItem Value="0" Disabled="true">
                                Seleccione:
                            </MudSelectItem>

                            @foreach (var zona in zonas)
                            {
                                <MudSelectItem Value="@zona.IdZona">
                                    @zona.Nombre
                                </MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                    <MudItem xs="6">
                        <MudSelect T="int"
           Label="Selecciona un año"
           Value="_anioSeleccionado"
           ValueChanged="OnAnioChanged"
           Variant="Variant.Outlined"
           Size="Size.Small"
           Margin="Margin.Dense"
                                       Class="field-white">

                            <MudSelectItem Value="0" Disabled="true">
                                Seleccione:
                            </MudSelectItem>

                            @foreach (var anio in ObtenerAnios())
                            {
                                <MudSelectItem Value="@anio">
                                    @anio
                                </MudSelectItem>
                            }

                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudItem>

        </MudGrid>

        <MudGrid Class="mb-3">

            <MudItem xs="12">

                <!-- TABLA -->
                <MudPaper Class="pa-4 mt-4" Elevation="2" Style="width:100%;">
                    <MudTable Class="tabla-subzonas"
                              Items="filteredSubzonas"
                              RowsPerPage="6"
                              Dense="true"
                              Bordered="true"
                              Hover="true"
                              Striped="true"
                              Elevation="1"
                              Breakpoint="Breakpoint.Sm">

                        <PagerContent>
                            <div style="display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:6px 10px;font-size:13px;color:#666;">

                                <MudTablePager HideRowsPerPage="true"
                                               AllItemsText=""
                                               InfoFormat="{first_item}-{last_item} de {all_items}" />
                            </div>
                        </PagerContent>

                            <ToolBarContent>
                                <div style="width:100%; display:flex; align-items:center; padding:4px 8px; position:relative;">

                                    <!-- CENTRO -->
                                    <div style="position:absolute; left:50%; transform:translateX(-50%);
                    font-weight:600; font-size:14px; color:#111827;">
                                        SUBZONAS REGISTRADAS
                                    </div>

                                    <!-- DERECHA -->
                                    <div style="margin-left:auto; width:243px;">
                                        <MudTextField @bind-Value="_filtroNombre"
                                                      Placeholder="Buscar..."
                                                      Variant="Variant.Outlined"
                                                      Size="Size.Small"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      Clearable="true"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                                    </div>

                                </div>
                            </ToolBarContent>


                        <HeaderContent>
                            <MudTh>Subzona</MudTh>
                            <MudTh>Punto de Ubicación</MudTh>
                            <MudTh>Capacidad</MudTh>
                            <MudTh>Disponibles</MudTh>
                            <MudTh class="text-center">Acción</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd>@context.Nombre</MudTd>
                            <MudTd>@context.PuntoUbicacion</MudTd>
                            <MudTd>@context.CapacidadTotal</MudTd>
                            <MudTd>
                                @($"{context.Ocupados} / {context.CapacidadTotal}")
                            </MudTd>
                            <MudTd class="text-center">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@((context.Ocupados >= context.CapacidadTotal))"
                                           OnClick="() => AgregarSubzona(context)">
                                    Agregar
                                </MudButton>
                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                </MudPaper>

            </MudItem>

        </MudGrid>
        </MudPaper>



    </DialogContent>

</MudDialog>
<style>
    .subzona-llena {
        background-color: #ff7070 !important; /* rojo claro */
    }

    .subzona-ambar {
        background-color: #fff3cd !important; /* amarillo claro */
    }

    .subzona-verde {
        background-color: #e0f7e9 !important; /* verde claro*/
    }


</style>
@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private string _baseUrl = "http://192.168.0.139:148";
    //private string _baseUrl = "http://localhost:5297";

    private int _zonaSeleccionada;
    private bool _buscado = false;
    private List<ZonasAutApi> zonas = new();
    private List<SubZonasAutApi> subzonas = new();
    private string _filtroNombre = string.Empty;
    private string color = "";
    private int _anioSeleccionado = DateTime.Now.Year; // Año actual por defecto
    private List<PuntoUbicacionApi> puntosUbicacion = new();

    public class PuntoUbicacionApi
    {
        public int IdSubzona { get; set; }
        public string Punto_Ubicacion { get; set; }
    }


    private IEnumerable<SubZonasAutApi> filteredSubzonas =>
        string.IsNullOrWhiteSpace(_filtroNombre)
            ? subzonas
            : subzonas.Where(s => s.Nombre.Contains(_filtroNombre, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender) {
            var dotNetRef = DotNetObjectReference.Create(this);
            //await JS.InvokeVoidAsync("googleMaps.initMap", dotNetRef);
        }
    }
    protected override async Task OnInitializedAsync() {
        var rs = await Http.GetFromJsonAsync<ZonasAutDTO>($"{_baseUrl}/api/Solicitud/getzonam");
        zonas = rs.response;
    }

    private async Task BuscarSubzonas()
    {
        subzonas = new List<SubZonasAutApi>();
        _filtroNombre = string.Empty;

        await MapsInterop.ClearMarkers();

        var res = await Http.GetFromJsonAsync<SubZonasAutDTO>(
            $"{_baseUrl}/api/MarkMaps/getall/{_zonaSeleccionada}/{_anioSeleccionado}");

        subzonas = res?.response ?? new List<SubZonasAutApi>();
        _buscado = true;


        try
        {
            puntosUbicacion = await Http.GetFromJsonAsync<List<PuntoUbicacionApi>>(
                "http://localhost:5297/api/PuntoUbicacion?idZona=" + _zonaSeleccionada
            ) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error PuntoUbicacion: " + ex.Message);
        }


        // ⚡ OPTIMIZADO: diccionario (MUCHO más rápido que FirstOrDefault)
        var dictPuntos = puntosUbicacion
            .ToDictionary(x => x.IdSubzona, x => x.Punto_Ubicacion);

        foreach (var subzona in subzonas)
        {
            subzona.PuntoUbicacion =
                dictPuntos.TryGetValue(subzona.idSubzona, out var punto)
                    ? punto
                    : "";
        }

        // MARKERS
        foreach (var subzona in subzonas)
        {
            if (!string.IsNullOrWhiteSpace(subzona.Coordenadas))
            {
                var partes = subzona.Coordenadas.Split(',');

                if (partes.Length >= 2 &&
                    double.TryParse(partes[1], out double lat) &&
                    double.TryParse(partes[0], out double lng))
                {
                    string titulo = subzona.Nombre;
                    string contenido =
                        $"<b>{subzona.Nombre}</b><br>Disponibilidad: {subzona.Ocupados}/{subzona.CapacidadTotal}";

                    color = subzona.Ocupados >= subzona.CapacidadTotal
                        ? "rojo"
                        : subzona.Ocupados == 3
                            ? "ambar"
                            : "verde";

                    await MapsInterop.AddMarker(lat, lng, titulo, contenido, color);
                }
            }
        }
    }


    private List<int> ObtenerAnios() {
        var anioActual = DateTime.Now.Year;
        var anios = new List<int>();

        for(int i = 2024; i <= anioActual + 3; i++) {
            anios.Add(i);
        }

        return anios;
    }

    private async Task AgregarSubzona(SubZonasAutApi subzona)
    {
        MudDialog?.Close(DialogResult.Ok(new ResultadoZona
        {
            IdSubZona = subzona.idSubzona,
            NombreSubZona = subzona.Nombre,
            PuntoUbicacion = subzona.PuntoUbicacion
        }));
    }

    public class ResultadoZona
    {
        public int IdSubZona { get; set; }
        public string NombreSubZona { get; set; }
        public string PuntoUbicacion { get; set; }
    }

    private async Task OnZonaChanged(int value)
    {
        _zonaSeleccionada = value;

        if (_zonaSeleccionada > 0 && _anioSeleccionado > 0)
            await BuscarSubzonas();
    }

    private async Task OnAnioChanged(int value)
    {
        _anioSeleccionado = value;

        if (_zonaSeleccionada > 0 && _anioSeleccionado > 0)
            await BuscarSubzonas();
    }

    void Cerrar() => MudDialog?.Close();
}
