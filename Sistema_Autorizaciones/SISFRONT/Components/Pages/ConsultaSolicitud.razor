@page "/ConsultaSolicitud"
@using SistemaLicencias.SHARED.DTOs
@inject HttpClient Http
@inject NavigationManager NavigationManager



<div class="filtros-container mb-4">
    <div class="filtros-row">

        <div class="filtro-item">
            <label class="form-label">Estado:</label>
            <select class="form-select"
                    value="@estadoSeleccionado"
                    @onchange="OnEstadoChanged">
                <option value="1">Pendiente</option>
                <option value="2">Anulado</option>
            </select>
        </div>

        <div class="filtro-item">
            <label class="form-label">Fecha Registro:</label>
            <input type="date" class="form-control" @bind="fechaRegistro" />
        </div>

        <div class="filtro-item">
            <label class="form-label">N° Autorización:</label>
            <input class="form-control" @bind="nroAutorizacion" />
        </div>

        <div class="filtro-item">
            <label class="form-label">Solicitante:</label>
            <input class="form-control" @bind="solicitante" />
        </div>

        <div class="filtro-item">
            <label class="form-label">Zona:</label>
            <input class="form-control" @bind="zona" />
        </div>

        <button class="mb-2 d-flex align-items-center gap-2"
                style="background-color:#198754; border:1px solid #198754; color:white; padding:6px 12px; border-radius:6px;"
                @onclick="ExportarExcel">

            <span style="font-size:18px;">📄</span>
            <strong>Excel</strong>
        </button>

    </div>
</div>

@if (solicitudesFiltradas == null)
{
    <p>Cargando...</p>
}
else if (!solicitudesFiltradas.Any())
{
    <p>No hay resultados.</p>
}
else
{
    <div class="tabla-container">

        <div class="tabla-header">
            <h5>Solicitudes</h5>
            <span>@solicitudesFiltradas.Count registros</span>
        </div>

        <div class="tabla-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-header">
                    <tr>
                        <th>N° Autorización</th>
                        <th>N° Expediente</th>
                        <th>N° Resolución</th>
                        <th>Solicitante</th>
                        <th>Zona</th>
                        <th>Giro</th>
                        <th>Fecha Registro</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                    <tbody>
                        @foreach (var item in SolicitudesPaginadas)
                        {
                            <tr>
                                <td>@item.NroAutorizacion</td>

                                <td>
                                    @($"{item.NroExpediente} - {item.FechaRegistro?.Year}")
                                </td>

                                <td>
                                    @($"{item.NroResolucion} - {item.FechaRegistro?.Year}")
                                </td>

                                <td>@item.Solicitante</td>
                                <td>@item.NombreSubzona</td>
                                <td>@item.NombreGiro</td>
                                <td>@item.FechaRegistro?.ToString("dd/MM/yyyy")</td>
                                <td>@ObtenerEstadoTexto(item.Estado)</td>
                            </tr>
                        }
                    </tbody>
            </table>
        </div>
        </div>
    </div>

    <div class="paginacion-container">

    <button class="btn btn-outline-primary btn-sm"
            @onclick="PaginaAnterior"
            disabled="@(paginaActual == 1)">
        ◀
    </button>

    <span class="mx-2">
        Página @paginaActual de @TotalPaginas
    </span>

    <button class="btn btn-outline-primary btn-sm"
            @onclick="PaginaSiguiente"
            disabled="@(paginaActual == TotalPaginas)">
        ▶
    </button>

</div>


}

@code {

    private int paginaActual = 1;
    private int tamanioPagina = 20;

    private int TotalPaginas =>
        (int)Math.Ceiling((double)(solicitudesFiltradas?.Count ?? 0) / tamanioPagina);

    private List<ConsultaSolicitudDto>? solicitudes;
    private List<ConsultaSolicitudDto>? solicitudesFiltradas;

    private string estadoSeleccionado = "1";

    private string? _nroAutorizacion;
    private string? nroAutorizacion
    {
        get => _nroAutorizacion;
        set
        {
            _nroAutorizacion = value;
            FiltrarLocal();
        }
    }

    private string? _solicitante;
    private string? solicitante
    {
        get => _solicitante;
        set
        {
            _solicitante = value;
            FiltrarLocal();
        }
    }

    private string? _zona;
    private string? zona
    {
        get => _zona;
        set
        {
            _zona = value;
            FiltrarLocal();
        }
    }

    private DateTime? _fechaRegistro;
    private DateTime? fechaRegistro
    {
        get => _fechaRegistro;
        set
        {
            _fechaRegistro = value;
            FiltrarLocal();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
    }

    private async Task OnEstadoChanged(ChangeEventArgs e)
    {
        estadoSeleccionado = e.Value?.ToString() ?? "1";
        await CargarSolicitudes();
    }

    private async Task CargarSolicitudes()
    {
        solicitudes = await Http.GetFromJsonAsync<List<ConsultaSolicitudDto>>(
            $"http://localhost:5297/api/ConsultaSolicitudes/listar?estado={estadoSeleccionado}"
        );

        FiltrarLocal();
    }
    private string ObtenerEstadoTexto(string estado)
    {
        return estado switch
        {
            "1" => "Pendiente",
            "2" => "Anulado",
            _ => "Desconocido"
        };
    }

    private void FiltrarLocal()
    {
        paginaActual = 1;

        if (solicitudes == null)
            return;

        IEnumerable<ConsultaSolicitudDto> query = solicitudes;

        if (!string.IsNullOrWhiteSpace(nroAutorizacion))
            query = query.Where(x =>
                x.NroAutorizacion != null &&
                x.NroAutorizacion.Contains(nroAutorizacion, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(solicitante))
            query = query.Where(x =>
                x.Solicitante != null &&
                x.Solicitante.Contains(solicitante, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(zona))
            query = query.Where(x =>
                x.NombreSubzona != null &&
                x.NombreSubzona.Contains(zona, StringComparison.OrdinalIgnoreCase));

        if (fechaRegistro.HasValue)
            query = query.Where(x =>
                x.FechaRegistro.HasValue &&
                x.FechaRegistro.Value.Date == fechaRegistro.Value.Date);

        // 👇 ORDENAMIENTO (más reciente primero)
        query = query.OrderByDescending(x => x.FechaRegistro);

        solicitudesFiltradas = query.ToList();
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
            paginaActual--;
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
            paginaActual++;
    }

    private IEnumerable<ConsultaSolicitudDto> SolicitudesPaginadas =>
    solicitudesFiltradas?
        .Skip((paginaActual - 1) * tamanioPagina)
        .Take(tamanioPagina)
        ?? Enumerable.Empty<ConsultaSolicitudDto>();

    private void ExportarExcel()
    {
        var url =
            $"http://localhost:5297/api/ConsultaSolicitudes/exportar?estado={estadoSeleccionado}";

        NavigationManager.NavigateTo(url, forceLoad: true);
    }



}


