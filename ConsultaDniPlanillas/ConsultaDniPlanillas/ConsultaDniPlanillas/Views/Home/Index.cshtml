                    </div>
                </div>

                <div class="card card-modern border mb-4 bg-light bg-opacity-50">
                    <div class="p-4">
                        <span class="text-muted small fw-bold d-block mb-3 text-uppercase tracking-wide" style="font-size:0.65rem">
