                                <span class="text-muted x-small d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.3px;">Días Laborados</span>
                            </div>
                            <div class="col border-start">
                                <div class="fw-bold text-danger fs-6" id="lblDiasNoLab">0</div>
                                <span class="text-muted x-small d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.3px;">Días No Laborados.</span>
                            </div>
                            <div class="col border-start">
                                <div class="fw-bold text-warning fs-6" id="lblSubsidios">0</div>
                                <span class="text-muted x-small d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.3px;">Días Subsidiados</span>
                            </div>
                            <div class="col border-start">
                                <div class="fw-bold text-info fs-6" id="lblVacaciones">0</div>
                                <span class="text-muted x-small d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.3px;">Periodo Vacacional</span>
                            </div>
                        </div>
                    </div>
                </div>


                    
