                            <div class="card-header bg-success bg-opacity-10 border-0 py-2 px-3">
                                <h6 class="fw-bold text-success mb-0" style="font-size: 0.85rem;"><i class="fas fa-plus-circle me-2"></i>Ingresos / Remuneraciones</h6>
                            </div>
                            <div class="card-body p-0 bg-white">
                                <table class="table table-hover table-borderless align-middle mb-0" id="tblModalIngresos" style="font-size: 0.8rem;">
                                    <tbody class="text-secondary"></tbody>
                                </table>
                            </div>
                            <div class="card-footer bg-white border-top py-2 px-3 d-flex justify-content-between align-items-center fw-bold text-success" style="font-size: 0.85rem;">
