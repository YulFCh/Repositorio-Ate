@{
    ViewData["Title"] = "Historial de Boletas Digitales";
}

<style>
    body {
        background-color: #f4f7f6;
    }

    .card-modern {
        background: #ffffff;
        border-radius: 16px !important;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .form-control-modern, .form-select-modern {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 1rem;
        background-color: #f8fafc;
        transition: all 0.2s ease-in-out;
    }

        .form-control-modern:focus, .form-select-modern:focus {
            background-color: #fff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        border: none;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        transition: all 0.2s;
    }

        .btn-gradient-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
            color: white;
        }

    .table-modern thead th {
        background-color: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border: none;
    }

    .table-modern tbody tr {
        border-bottom: 1px solid #f1f5f9;
    }

    .boleta-container {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        font-size: 0.88rem;
    }

    .boleta-section-title {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #64748b;
        border-bottom: 2px solid #cbd5e1;
        padding-bottom: 4px;
        margin-bottom: 12px;
    }

    .data-item {
        margin-bottom: 0.4rem;
    }

    .data-label {
        color: #64748b;
        font-weight: 500;
        display: inline-block;
        width: 150px; 
    }

    .data-value {
        color: #0f172a;
        font-weight: 600;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        #boletaImprimible, #boletaImprimible * {
            visibility: visible;
        }

        #boletaImprimible {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .modal-footer, .btn-close {
            display: none !important;
        }
    }
</style>



<div class="container-fluid mt-5 px-lg-5">
    <div class="card card-modern mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex align-items-center mb-4">
    
    <div class="p-2 bg-white rounded-3 me-3 shadow-sm d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border: 1px solid #e2e8f0;">
        <span style="display: block; width: 10px; height: 10px; background-color: #10b981; border-radius: 50%;"></span>
    </div>
    
    <div>
        <h4 class="fw-bold mb-1 text-dark">Historial de Boletas de Pago</h4>
        <p class="text-muted mb-0 small">Filtre y visualice sus boletas ingresando los datos correspondientes.</p>
    </div>
</div>

            <form id="searchForm" class="row g-4">
                <div class="col-md-3">
                    <label for="dni" class="form-label small fw-semibold text-muted">Documento DNI *</label>
                    <input type="text" class="form-control form-control-modern" id="dni" placeholder="Ingrese DNI" maxlength="10" required>
                </div>
                <div class="col-md-3">
                    <label for="anio" class="form-label small fw-semibold text-muted">Año Laboral</label>
                    <input type="number" class="form-control form-control-modern" id="anio" placeholder="Ej. 2026" min="2000" max="2099">
                </div>
                <div class="col-md-3">
                    <label for="mesDesde" class="form-label small fw-semibold text-muted">Desde el Mes</label>
                    <select class="form-select form-select-modern" id="mesDesde">
                        <option value="">-- Todos --</option>
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="mesHasta" class="form-label small fw-semibold text-muted">Hasta el Mes</label>
                    <select class="form-select form-select-modern" id="mesHasta">
                        <option value="">-- Todos --</option>
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>
                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-gradient-primary">
                        <i class="fas fa-spinner fa-spin d-none me-2" id="loadingSpinner"></i>
                        <i class="fas fa-filter me-2" id="searchIcon"></i>Consultar Registros
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="alertContainer"></div>

    <div class="card card-modern d-none" id="resultsCard">
        <div class="card-body p-0">
            <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-list-ul text-muted me-2"></i>Resultados</h5>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small fw-medium">Datos en tiempo real</span>
            </div>
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0" id="boletasTable" style="font-size: 0.88rem;">
                    <thead>
                        <tr>
                            <th class="ps-4">Periodo</th>
                            <th>DNI</th>
                            <th>Código</th>
                            <th>Apellidos y Nombres</th>
                            <th>Condición Laboral</th>
                            <th>Cargo</th>
                            <th>Área</th>
                            <th>Fec. Ing.</th>
                            <th>Sis. Pensiones</th>
                            <th class="text-end">Situación</th>
                            <th class="text-center pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="text-secondary">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="boletaModal" tabindex="-1" aria-hidden="true">
