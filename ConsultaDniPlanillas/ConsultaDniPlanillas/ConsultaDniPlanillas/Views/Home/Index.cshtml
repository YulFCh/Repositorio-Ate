                            <span class="data-value flex-grow-1">: <span id="lblRegimen"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 180px;">Administrador de Pensión</span>
                            <span class="data-value flex-grow-1">: <span id="lblAdminPens"></span></span>
