                            <span class="text-muted fw-medium" style="width: 140px;">Código AIRHSP</span>
                            <span class="data-value flex-grow-1">: <span id="lblAirhsp"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 140px;">Establecimiento</span>
                            <span class="data-value flex-grow-1">: <span id="lblSede"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 140px;">Régimen Laboral</span>
                            <span class="data-value flex-grow-1">: <span id="lblRegimenLaboral"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 140px;">Condición</span>
                            <span class="data-value flex-grow-1">: <span id="lblCondicion"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 140px;">Grupo Ocupacional</span>
                            <span class="data-value flex-grow-1">: <span id="lblOcupacional"></span></span>
                        </div>
                        <div class="data-item d-flex">
                            <span class="text-muted fw-medium" style="width: 140px;">Cargo Estructural</span>
                            <span class="data-value flex-grow-1">: <span id="lblEstructural"></span></span>
                        </div>
                        <div class="data-item d-flex">
