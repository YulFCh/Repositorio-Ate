                                <span>S/ <span id="lblTotalIngresos">0.00</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card card-modern border h-100 bg-light bg-opacity-50" style="overflow: hidden;">
                            <div class="card-header bg-danger bg-opacity-10 border-0 py-2 px-3">
