@{
    ViewData["Title"] = "Historial de Boletas Digitales";
}

<style>
    body {
        background-color: #f4f7f6;
    }
    .card-modern {
        background: #ffffff;
        border-radius: 16px !important;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .form-control-modern, .form-select-modern {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 1rem;
        background-color: #f8fafc;
        transition: all 0.2s ease-in-out;
    }
    .form-control-modern:focus, .form-select-modern:focus {
        background-color: #fff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
    }
    .btn-gradient-primary {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        border: none;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        transition: all 0.2s;
    }
    .btn-gradient-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
        color: white;
    }
    /* Estilos tabla moderna */
    .table-modern thead th {
        background-color: #f1f5f9;
        color: #475569;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border: none;
    }
    .table-modern tbody tr {
        border-bottom: 1px solid #f1f5f9;
    }
    /* Diseño de Boleta Ejecutiva */
    .boleta-container {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1e293b;
        font-size: 0.88rem;
    }
    .boleta-header-badge {
        background-color: #eff6ff;
        color: #1d4ed8;
        padding: 0.5rem 1rem;
        border-radius: 30px;
        display: inline-block;
        font-weight: 600;
    }
    .boleta-section-title {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #64748b;
        border-bottom: 2px solid #cbd5e1;
        padding-bottom: 4px;
        margin-bottom: 12px;
    }
    .data-box {
        background-color: #f8fafc;
        border-radius: 12px;
        padding: 1rem;
        border: 1px solid #f1f5f9;
    }
    .data-item {
        margin-bottom: 0.4rem;
    }
    .data-label {
        color: #64748b;
        font-weight: 500;
    }
    .data-value {
        color: #0f172a;
        font-weight: 600;
    }
    /* Ocultar elementos al imprimir */
    @@media print {
        body * { visibility: hidden; }
        #boletaImprimible, #boletaImprimible * { visibility: visible; }
        #boletaImprimible { position: absolute; left: 0; top: 0; width: 100%; }
        .modal-footer, .btn-close { display: none !important; }
    }
</style>

<div class="container-fluid mt-5 px-lg-5">
    <div class="card card-modern mb-5">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                    <i class="fas fa-search fa-lg"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1 text-dark">Historial de Boletas de Pago</h4>
                    <p class="text-muted mb-0 small">Filtre y visualice sus boletas ingresando los datos correspondientes.</p>
                </div>
            </div>
            
            <form id="searchForm" class="row g-4">
                <div class="col-md-3">
                    <label for="dni" class="form-label small fw-semibold text-muted">Documento DNI *</label>
                    <input type="text" class="form-control form-control-modern" id="dni" placeholder="Ingrese DNI" maxlength="10" required>
                </div>
                <div class="col-md-3">
                    <label for="anio" class="form-label small fw-semibold text-muted">Año Laboral</label>
                    <input type="number" class="form-control form-control-modern" id="anio" placeholder="Ej. 2026" min="2000" max="2099">
                </div>
                <div class="col-md-3">
                    <label for="mesDesde" class="form-label small fw-semibold text-muted">Desde el Mes</label>
                    <select class="form-select form-select-modern" id="mesDesde">
                        <option value="">-- Todos --</option>
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="mesHasta" class="form-label small fw-semibold text-muted">Hasta el Mes</label>
                    <select class="form-select form-select-modern" id="mesHasta">
                        <option value="">-- Todos --</option>
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>
                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-gradient-primary">
                        <i class="fas fa-spinner fa-spin d-none me-2" id="loadingSpinner"></i>
                        <i class="fas fa-filter me-2" id="searchIcon"></i>Consultar Registros
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="alertContainer"></div>

    <div class="card card-modern d-none" id="resultsCard">
        <div class="card-body p-0">
            <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-list-ul text-muted me-2"></i>Registros de Planilla Encontrados</h5>
                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small fw-medium">Datos en tiempo real</span>
            </div>
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0" id="boletasTable" style="font-size: 0.88rem;">
                    <thead>
                        <tr>
                            <th class="ps-4">Periodo</th>
                            <th>DNI</th>
                            <th>Código</th>
                            <th>Apellidos y Nombres</th>
                            <th>Condición Laboral</th>
                            <th>Cargo</th>
                            <th>Área / C. Costo</th>
                            <th>Fec. Ing.</th>
                            <th>Sis. Pensiones</th>
                            <th class="text-end">Neto Pagar</th>
                            <th class="text-center pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="text-secondary">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="boletaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 bg-light py-3 px-4">
                <div class="d-flex align-items-center">
                    <i class="fas fa-file-invoice-dollar text-primary fa-lg me-2"></i>
                    <h6 class="modal-title fw-bold text-dark mb-0">Visualización de Boleta Electrónica</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 p-lg-5 boleta-container" id="boletaImprimible">
                
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-4 mb-4">
                    <div>
                        <span class="boleta-header-badge mb-2" id="lblCondicionTitulo"></span>
                        <h4 class="fw-bold text-slate-900 mb-0">BOLETA DE PAGO DIGITAL</h4>
                    </div>
                    <div class="text-md-end mt-2 mt-md-0">
                        <span class="text-muted small d-block">Periodo Declarado</span>
                        <span class="fs-5 fw-bold text-primary" id="lblPeriodoTitulo"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="data-box h-100">
                            <div class="boleta-section-title"><i class="fas fa-building me-2"></i>Información del Empleador</div>
                            <div class="data-item"><span class="data-label">Entidad:</span> <span class="data-value" id="lblEntidad"></span></div>
                            <div class="data-item"><span class="data-label">Empleador:</span> <span class="data-value" id="lblEmpleador"></span></div>
                            <div class="data-item"><span class="data-label">RUC:</span> <span class="data-value" id="lblRuc"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="data-box h-100">
                            <div class="boleta-section-title"><i class="fas fa-coins me-2"></i>Estructura Presupuestal</div>
                            <div class="data-item"><span class="data-label">Rubro Financiamiento:</span> <span class="data-value" id="lblRubro"></span></div>
                            <div class="data-item"><span class="data-label">Meta Presupuestal:</span> <span class="data-value" id="lblMeta"></span></div>
                            <div class="data-item"><span class="data-label">Unidad Orgánica:</span> <span class="data-value" id="lblUnidadOrganica"></span></div>
                        </div>
                    </div>
                </div>

                <div class="card card-modern border mb-4 bg-light bg-opacity-50">
                    <div class="card-body p-4">
                        <div class="boleta-section-title"><i class="fas fa-user-tie me-2"></i>Datos Personales y Laborales del Servidor</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="data-item"><span class="data-label">Doc. Identidad (DNI):</span> <span class="data-value" id="lblDni"></span></div>
                                <div class="data-item"><span class="data-label">Apellidos y Nombres:</span> <span class="data-value text-primary" id="lblNombre"></span></div>
                                <div class="data-item"><span class="data-label">Cargo Ejecutado:</span> <span class="data-value" id="lblCargo"></span></div>
                                <div class="data-item"><span class="data-label">Fecha de Ingreso:</span> <span class="data-value" id="lblFechaIngreso"></span></div>
                                <div class="data-item"><span class="data-label">Régimen Pensionario:</span> <span class="data-value" id="lblRegimen"></span></div>
                                <div class="data-item"><span class="data-label">Administradora (AFP/ONP):</span> <span class="data-value" id="lblAdminPens"></span></div>
                                <div class="data-item"><span class="data-label">Código CUSPP:</span> <span class="data-value" id="lblCuspp"></span></div>
                            </div>
                            <div class="col-md-6 border-start-md">
                                <div class="data-item"><span class="data-label">Código AIRHSP:</span> <span class="data-value" id="lblAirhsp"></span></div>
                                <div class="data-item"><span class="data-label">Establecimiento / Sede:</span> <span class="data-value" id="lblSede"></span></div>
                                <div class="data-item"><span class="data-label">Régimen Laboral:</span> <span class="data-value" id="lblRegimenLaboral"></span></div>
                                <div class="data-item"><span class="data-label">Condición:</span> <span class="data-value" id="lblCondicion"></span></div>
                                <div class="data-item"><span class="data-label">Cargo Estructural:</span> <span class="data-value" id="lblEstructural"></span></div>
                                <div class="data-item"><span class="data-label">Código del Empleado:</span> <span class="data-value" id="lblCodEmpleado"></span></div>
                                <div class="data-item"><span class="data-label">Fracción y Tipo Pensión:</span> <span class="data-value" id="lblTipoComision"></span></div>
                            </div>
                        </div>
                        
                        <div class="mt-4 p-3 bg-white rounded-3 border">
                            <span class="text-muted small fw-bold d-block mb-2 text-uppercase tracking-wide" style="font-size:0.7rem">Resumen de Asistencia del Periodo</span>
                            <div class="row text-center g-2">
                                <div class="col"><div class="fw-bold text-dark fs-6" id="lblJornada">0</div><span class="text-muted x-small d-block text-uppercase">Jornada</span></div>
                                <div class="col border-start"><div class="fw-bold text-success fs-6" id="lblDiasLab">0</div><span class="text-muted x-small d-block text-uppercase">Días Lab.</span></div>
                                <div class="col border-start"><div class="fw-bold text-danger fs-6" id="lblDiasNoLab">0</div><span class="text-muted x-small d-block text-uppercase">No Lab.</span></div>
                                <div class="col border-start"><div class="fw-bold text-warning fs-6" id="lblSubsidios">0</div><span class="text-muted x-small d-block text-uppercase">Subsidios</span></div>
                                <div class="col border-start"><div class="fw-bold text-info fs-6" id="lblVacaciones">0</div><span class="text-muted x-small d-block text-uppercase">Vacaciones</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card card-modern border h-100">
                            <div class="card-header bg-success bg-opacity-10 border-0 py-3">
                                <h6 class="fw-bold text-success mb-0"><i class="fas fa-plus-circle me-2"></i>Ingresos / Remuneraciones</h6>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover table-borderless align-middle mb-0" id="tblModalIngresos" style="font-size: 0.85rem;">
                                    <tbody class="text-secondary"></tbody>
                                </table>
                            </div>
                            <div class="card-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center fw-bold text-success">
                                <span>TOTAL INGRESOS:</span>
                                <span>S/ <span id="lblTotalIngresos">0.00</span></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card card-modern border h-100">
                            <div class="card-header bg-danger bg-opacity-10 border-0 py-3">
                                <h6 class="fw-bold text-danger mb-0"><i class="fas fa-minus-circle me-2"></i>Egresos / Descuentos</h6>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover table-borderless align-middle mb-0" id="tblModalEgresos" style="font-size: 0.85rem;">
                                    <tbody class="text-secondary"></tbody>
                                </table>
                            </div>
                            <div class="card-footer bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center fw-bold text-danger">
                                <span>TOTAL DESCUENTOS:</span>
                                <span>S/ <span id="lblTotalEgresos">0.00</span></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-modern border mt-4">
                    <div class="card-header bg-light border-0 py-2">
                        <span class="text-muted fw-bold small text-uppercase" style="font-size:0.75rem">Aportaciones Institucionales (Empleador)</span>
                    </div>
                    <div class="card-body p-0 row g-0 align-items-center">
                        <div class="col-md-8">
                            <table class="table table-borderless mb-0 py-2" id="tblModalAportes" style="font-size: 0.85rem;">
                                <tbody class="text-primary fw-medium"></tbody>
                            </table>
                        </div>
                        <div class="col-md-4 text-md-end p-3 bg-light border-start fw-bold text-primary">
                            <span class="small d-block text-muted fw-normal">Total Aportado:</span>
                            S/ <span id="lblTotalAportes">0.00</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 p-4 rounded-4 d-flex justify-content-between align-items-center shadow-sm" style="background: linear-gradient(135deg, #1e293b, #0f172a); color: #fbbf24;">
                    <div class="d-flex align-items-center">
                        <div class="p-3 bg-white bg-opacity-10 rounded-3 me-3 text-warning">
                            <i class="fas fa-wallet fa-lg"></i>
                        </div>
                        <div>
                            <span class="x-small d-block text-uppercase text-white text-opacity-70 fw-medium" style="letter-spacing:1px">Líquido a Percibir</span>
                            <h5 class="fw-bold mb-0 text-white">NETO A PAGAR</h5>
                        </div>
                    </div>
                    <div class="text-end">
                        <h3 class="fw-black mb-0" style="font-size: 1.8rem; font-weight:800;">S/ <span id="lblNetoPagar">0.00</span></h3>
                    </div>
                </div>

            </div>
            
            <div class="modal-footer bg-light border-0 rounded-bottom-4 py-3 px-4">
                <button type="button" class="btn btn-outline-primary rounded-3 px-3" onclick="window.print();">
                    <i class="fas fa-print me-2"></i>Imprimir Boleta Oficial
                </button>
                <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Cerrar Ventana</button>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE = "http://192.168.4.91:203/api/ConsultaDni";

    document.getElementById("searchForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const dni = document.getElementById("dni").value;
        const anio = document.getElementById("anio").value;
        const mesDesde = document.getElementById("mesDesde").value;
        const mesHasta = document.getElementById("mesHasta").value;

        let url = `${API_BASE}/historial/${dni}?`;

        if (anio) url += `anio=${anio}&`;
        if (mesDesde) url += `mesDesde=${mesDesde}&`;
        if (mesHasta) url += `mesHasta=${mesHasta}`;

        try {
            document.getElementById("loadingSpinner").classList.remove("d-none");

            const response = await fetch(url, {
                method: "GET",
                headers: { "Accept": "application/json" }
            });

            if (!response.ok) throw new Error("Error al consultar la API");

            const data = await response.json();
            cargarTabla(data);

        } catch (error) {
            console.error(error);
            alert(error.message);
        } finally {
            document.getElementById("loadingSpinner").classList.add("d-none");
        }
    });

    function cargarTabla(lista) {
        const tbody = document.querySelector("#boletasTable tbody");
        tbody.innerHTML = "";

        if (lista.length === 0) {
            document.getElementById("resultsCard").classList.add("d-none");
            return;
        }

        lista.forEach(item => {
            const pMes = item.mes.toString().padStart(2, '0');
            const periodo = `${pMes}/${item.anio}`;
            
            const regimenDesc = item.tipoPension || item.regimenPensionario || "-";
            const codEmp = item.codEmpleado || item.idEmpleado;

            // Se duplica la '@@' para escapar el motor Razor de ASP.NET
            const itemString = JSON.stringify(item).replace(/'/g, "&@@apos;");

            tbody.innerHTML += `
                <tr>
                    <td class="ps-4 fw-semibold text-dark">${periodo}</td>
                    <td>${item.dni}</td>
                    <td><span class="badge bg-light text-secondary border px-2 py-1">${codEmp}</span></td>
                    <td class="fw-medium text-dark">${item.nombresCompletos}</td>
                    <td>${item.condicionLaboral}</td>
                    <td>${item.cargo}</td>
                    <td>${item.centroCosto}</td>
                    <td>${item.fechaIngreso}</td>
                    <td>${regimenDesc}</td>
                    <td class="text-end fw-bold text-dark">S/ ${item.netoPagar.toFixed(2)}</td>
                    <td class="text-center pe-4">
                        <button class="btn btn-sm btn-light border text-primary rounded-3" onclick='verBoleta(${itemString})' title="Ver Boleta">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>`;
        });

        document.getElementById("resultsCard").classList.remove("d-none");
    }

    function verBoleta(item) {
        $("#lblPeriodoTitulo").text(`${item.mes.toString().padStart(2, '0')} - ${item.anio}`);
        $("#lblCondicionTitulo").text(item.condicionLaboral ? item.condicionLaboral.toUpperCase() : "");

        $("#lblEntidad").text(item.entidad || "Municipalidad Distrital de Ate");
        $("#lblEmpleador").text(item.empleador || "Municipalidad Distrital de Ate");
        $("#lblRuc").text(item.ruc || "20131378620");
        $("#lblRubro").text(item.rubro || "-");
        $("#lblMeta").text(item.meta || "-");
        $("#lblUnidadOrganica").text(item.centroCosto || "-");

        $("#lblDni").text(item.dni);
        $("#lblAirhsp").text(item.airhsp || "-");
        $("#lblNombre").text(item.nombresCompletos);
        $("#lblCargo").text(item.cargo);
        $("#lblFechaIngreso").text(item.fechaIngreso);
        $("#lblRegimen").text(item.tipoPension || "-");
        $("#lblAdminPens").text(item.adminPens || "-");
        $("#lblCuspp").text(item.cuspp || "-");

        $("#lblSede").text(item.sede || "PALACIO MUNICIPAL");
        $("#lblRegimenLaboral").text(item.condicionLaboral || "-");
        $("#lblCondicion").text(item.condicion || "-");
        $("#lblEstructural").text(item.estructural || "-");
        $("#lblCodEmpleado").text(item.codEmpleado || item.idEmpleado);
        $("#lblTipoComision").text(item.tipoComision || "-");

        $("#lblJornada").text(item.jornada || 0);
        $("#lblDiasLab").text(item.diasLaborados || 0);
        $("#lblDiasNoLab").text(item.diasNoLaborados || 0);
        $("#lblSubsidios").text(item.subsidios || 0);
        $("#lblVacaciones").text(item.vacaciones || 0);

        $("#lblTotalIngresos").text(item.totalIngresos.toFixed(2));
        $("#lblTotalEgresos").text(item.totalEgresos.toFixed(2));
        $("#lblNetoPagar").text(item.netoPagar.toFixed(2));

        const ingresosArr = typeof item.ingresos === 'string' ? JSON.parse(item.ingresos || "[]") : (item.ingresos || []);
        const egresosArr = typeof item.egresos === 'string' ? JSON.parse(item.egresos || "[]") : (item.egresos || []);
        const aportesArr = typeof item.aportes === 'string' ? JSON.parse(item.aportes || "[]") : (item.aportes || []);

        let htmlIngresos = "";
        ingresosArr.forEach(i => {
            htmlIngresos += `
            <tr>
                <td class="ps-3">${i.codigoInterno} - ${i.concepto}</td>
                <td class="text-end pe-3 fw-medium text-success">+ S/ ${i.monto.toFixed(2)}</td>
            </tr>`;
        });
        $("#tblModalIngresos tbody").html(htmlIngresos || "<tr><td colspan='2' class='text-muted text-center py-3'>Sin registros</td></tr>");

        let htmlEgresos = "";
        egresosArr.forEach(i => {
            htmlEgresos += `
            <tr>
                <td class="ps-3">${i.codigoInterno} - ${i.concepto}</td>
                <td class="text-end pe-3 fw-medium text-danger">- S/ ${i.monto.toFixed(2)}</td>
            </tr>`;
        });
        $("#tblModalEgresos tbody").html(htmlEgresos || "<tr><td colspan='2' class='text-muted text-center py-3'>Sin registros</td></tr>");

        let htmlAportes = "";
        let totalAportes = 0;
        aportesArr.forEach(i => {
            totalAportes += i.monto;
            htmlAportes += `
            <tr>
                <td class="ps-3">${i.codigoInterno} - ${i.concepto}</td>
                <td class="text-end pe-3 fw-medium text-primary">S/ ${i.monto.toFixed(2)}</td>
            </tr>`;
        });
        $("#tblModalAportes tbody").html(htmlAportes || "<tr><td colspan='2' class='text-muted text-center py-2'>Sin registros</td></tr>");
        $("#lblTotalAportes").text(totalAportes.toFixed(2));

        const modal = new bootstrap.Modal(document.getElementById("boletaModal"));
        modal.show();
    }
</script>