                                <tbody class="text-primary fw-medium"></tbody>
                            </table>
                        </div>
                        <div class="col-md-4 text-md-end p-2 pe-3 bg-light bg-opacity-25 border-start fw-bold text-primary" style="font-size: 0.85rem;">
                            <span class="text-muted fw-normal" style="font-size: 0.7rem; d-block;">Total Aportado:</span>
                            <span class="d-md-block">S/ <span id="lblTotalAportes">0.00</span></span>
                        </div>
                    </div>
                </div>

                <div class="mt-2 p-2 rounded-3 d-flex justify-content-between align-items-center border" style="background-color: #f1f5f9;">
